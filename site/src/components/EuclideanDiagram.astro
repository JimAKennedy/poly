---
interface Props {
  steps: number;
  hits: number;
  rotation?: number;
  radius?: number;
}

const { steps, hits, rotation = 0, radius = 80 } = Astro.props;

// Shared single-source generator — see site/src/audio/bjorklund.ts. The engine
// (engine/src/euclidean.cpp) mirrors this phase, enforced by the exhaustive
// equality test in tests/euclidean_tests.cpp, so diagrams show what the engine
// plays.
import { bjorklund, rotateRight } from '../audio/bjorklund.ts';

const onsets = bjorklund(steps, hits);
const rotated = rotateRight(onsets, rotation);

const size = radius * 2 + 40;
const cx = size / 2;
const cy = size / 2;

const positions = Array.from({ length: steps }, (_, i) => {
  const angle = (2 * Math.PI * i) / steps - Math.PI / 2;
  return {
    x: cx + radius * Math.cos(angle),
    y: cy + radius * Math.sin(angle),
    isHit: rotated[i],
  };
});

const label = `E(${hits},${steps})${rotation ? ` r${rotation}` : ''}`;
---

<figure class="euclidean-diagram">
  <svg
    width={size}
    height={size}
    viewBox={`0 0 ${size} ${size}`}
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label={`Euclidean rhythm diagram: ${label}`}
  >
    <circle cx={cx} cy={cy} r={radius} fill="none" stroke="var(--sl-color-gray-4)" stroke-width="1.5" />

    {positions.map((pos, i) => {
      const next = positions[(i + 1) % steps];
      if (pos.isHit && next.isHit) {
        return <line x1={pos.x} y1={pos.y} x2={next.x} y2={next.y} stroke="var(--poly-primary)" stroke-width="1.5" opacity="0.4" />;
      }
      return null;
    })}

    {positions.map((pos) => (
      <circle
        cx={pos.x}
        cy={pos.y}
        r={pos.isHit ? 7 : 5}
        fill={pos.isHit ? 'var(--poly-primary)' : 'var(--sl-color-black)'}
        stroke={pos.isHit ? 'var(--poly-primary-dark)' : 'var(--sl-color-gray-3)'}
        stroke-width={pos.isHit ? 2 : 1.5}
      />
    ))}
  </svg>
  <figcaption class="euclidean-label">{label}</figcaption>
</figure>

<style>
  .euclidean-diagram {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    margin: 1rem 0;
  }

  .euclidean-diagram svg {
    max-width: 100%;
    height: auto;
  }

  .euclidean-label {
    font-family: var(--sl-font-system-mono);
    font-size: var(--sl-text-xs);
    color: var(--poly-text-muted);
    margin-top: 0.3rem;
  }
</style>
