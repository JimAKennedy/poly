    "ref-1": {
      "obtainability": "open-access",
      "evidence": "arxiv.org/pdf/0705.4085.pdf returns 200 application/pdf, 483191 bytes. The PDF was read directly; its own margin stamp reads arXiv:0705.4085v1 [cs.CG] 28 May 2007.",
      "checked": "2026-09-20",
      "description": "mismatch",
      "note": "The URL serves \"The Distance Geometry of Music\" (Demaine, Gomez-Martin, Meijer, Rappaport, Taslakian, Toussaint, Winograd and Wood, 2007), not the 2005 BRIDGES paper \"The Euclidean Algorithm Generates Traditional Musical Rhythms\" that the entry names. Toussaint is one of eight authors rather than the sole author. Both works are real and both discuss Euclidean rhythms, so the link is useful, but the citation describes a different work from the one it points at. This is the guide’s foundational Euclidean citation.",
      "identifier": {
        "doi": null,
        "isbn": null
      },
      "price": null,
      "archiveFile": "01 - Toussaint.pdf"
    },
